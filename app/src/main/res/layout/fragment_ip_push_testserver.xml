<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:keepScreenOn="true">

    <!-- 节点链接：[[AABB]] 占位整个 IP，会被完整 IP 替换 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="节点链接:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etNodeLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textMultiLine"
        android:minLines="1"
        android:maxLines="3"
        android:hint="节点链接"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="最低速度 (KB/s):"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etMinKb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="只导出速度高于这个值的IP，0 表示全导"
        android:text="0"
        android:inputType="numberDecimal"
        android:singleLine="true"
        android:maxLines="1"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- 探测目标 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="探测目标 (VLESS/Trojan 链接 或 host:port/path):"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etProbeTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="留空则测 speed.cloudflare.com"
        android:inputType="textUri"
        android:singleLine="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:padding="12dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="粘贴代理链接后，「本地下载测速」会用它里面的 host/port/path 去访问目标 IP，并返回 HTTP 状态码、ALPN、证书。用来判断这个 IP 是否在同一个 Cloudflare 站点、路径是否存在"
        android:textSize="11sp"
        android:textColor="#888888" />

    <!-- 按钮容器（水平排列） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="2dp">

        <!-- 生成链接按钮 -->
        <Button
            android:id="@+id/btnExportLinks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="生成链接"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/teal_700"
            android:textColor="@android:color/white"
            style="@style/Widget.AppCompat.Button" />

        <Button
            android:id="@+id/btnLocalTestHttping"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="本地下载测速"
            android:layout_marginStart="8dp"
            style="@style/Widget.AppCompat.Button" />

        <Button
            android:id="@+id/stopTestDownloadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止测试"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/red_500"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnGenerateLink2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="剪切板IP生成链接"
            app:layout_constraintStart_toEndOf="@+id/btnLocalTestHttping"
            android:layout_marginStart="8dp"
            style="@style/Widget.AppCompat.Button" />

    </LinearLayout>

    <!-- 状态显示 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="就绪"
        android:textSize="13sp"
        android:textColor="#666666" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAbPrefixes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

</LinearLayout>
